# Mạng đang dùng được: preview (~20 phút đồng bộ cho mỗi ví mới). Preprod hiện không dùng được
# (đồng bộ ví chạy 40 phút rồi lỗi Wallet.Sync). Mặc định trong code vẫn là preprod nếu bỏ trống.
NETWORK=preview
# Chỉ cần khi NETWORK=preprod
BLOCKFROST_PROJECT_ID=
PINATA_JWT=
# PROOF_SERVER_URL=http://localhost:6300
# PORT=8787
# DATA_DIR=data
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# FUND_AMOUNT=100
# Số ví giữ mở trong SDK cùng lúc (1-20). Mở lại ví đã bị đóng phải đồng bộ lại từ đầu (~20 phút trên preview).
# MAX_OPEN_WALLETS=6
